{
  "name": "post-it",
  "private": true,
  "description": "Post it, une interface de réseau social open source : vitrine HTML/CSS moderne, sans framework ni étape de build.",
  "license": "MIT",
  "homepage": "https://balick.github.io/post-it/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Balick/post-it.git"
  },
  "bugs": {
    "url": "https://github.com/Balick/post-it/issues"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "serve .",
    "sync": "node scripts/sync-partials.mjs",
    "lint": "npm run lint:sync && npm run lint:css && npm run lint:html && npm run lint:format",
    "lint:sync": "node scripts/sync-partials.mjs --check",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:html": "html-validate \"*.html\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "html-validate": "^11.21.1",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
