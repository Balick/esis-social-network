{
  "$schema": "https://json.schemastore.org/stylelintrc.json",
  "extends": ["stylelint-config-standard"],
  "rules": {
    "declaration-property-value-no-unknown": [
      true,
      {
        "ignoreProperties": {
          "position-visibility": ["/anchors-(valid|visible)/"]
        }
      }
    ],
    "no-descending-specificity": null,
    "property-no-vendor-prefix": [true, { "ignoreProperties": ["-webkit-text-size-adjust"] }],
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:__[a-z0-9]+(?:-[a-z0-9]+)*)?(?:--[a-z0-9]+(?:-[a-z0-9]+)*)?$",
      {
        "message": "Nom de classe attendu en BEM : .block, .block__element ou .block--modifier (en kebab-case)"
      }
    ]
  }
}
